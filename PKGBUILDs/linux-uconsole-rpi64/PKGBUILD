_kcfg() {
  local option=$1
  local value=$2
  case "$value" in
    y)
      ./scripts/config --enable "$option"
      ;;
    n)
      ./scripts/config --disable "$option"
      ;;
    m)
      ./scripts/config --module "$option"
      ;;
    undef)
      ./scripts/config --undefine "$option"
      ;;
    *)
      ./scripts/config --set-str "$option" "$value"
      ;;
  esac
}

prepare() {
  cd ${_srcname}

  # add upstream patch, this is for upstream kernels
  #patch -Np1 < ${srcdir}/patch-${pkgver}

  echo "Setting version..."
  echo "-$pkgrel" > localversion.10-pkgrel
  echo "${pkgbase#linux}" > localversion.20-pkgname
  make -s defconfig
  make -s kernelrelease > version
  make -s mrproper

  # add custom patches
  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    src="${src%.zst}"
    [[ $src = *.patch ]] || continue
    echo "Applying patch $src..."
    patch -Np1 < "../$src"
  done

  echo "Setting config..."
  # cp ${srcdir}/config .config
  # make KERNELRELEASE="$(<version)" olddefconfig
  # diff -u ${srcdir}/config .config || :
  make KERNELRELEASE="$(<version)" bcm2711_defconfig

  # apply customized configs
  # first, drivers
  _kcfg INPUT_AXP20X_PEK m
  _kcfg CHARGER_AXP20X m
  _kcfg BATTERY_AXP20X m
  _kcfg AXP20X_POWER m
  _kcfg MFD_AXP20X m
  _kcfg MFD_AXP20X_I2C m
  _kcfg REGULATOR_AXP20X m
  _kcfg AXP20X_ADC m
  _kcfg BACKLIGHT_OCP8178 m
  _kcfg DRM_PANEL_CLOCKWORK_CWU50 m
  # second, other features
  _kcfg SECURITY_DMESG_RESTRICT y
  _kcfg SECURITY_LANDLOCK y
  _kcfg PROFILING y
  _kcfg BPF_SYSCALL y
  _kcfg KPROBE_EVENTS y
  _kcfg BPF_EVENTS y
  _kcfg BPF_STREAM_PARSER y
  _kcfg BPF_LSM y
  _kcfg LSM "landlock,lockdown,yama,integrity,apparmor,bpf"
  _kcfg DEBUG_KERNEL y
  _kcfg DEBUG_INFO y
  _kcfg DEBUG_INFO_NONE undef
  _kcfg DEBUG_INFO_REDUCED undef
  _kcfg DEBUG_INFO_DWARF5 y
  _kcfg DEBUG_INFO_BTF y
  _kcfg DEBUG_INFO_BTF_MODULES y

  # make sure it's valid
  make KERNELRELEASE="$(<version)" olddefconfig

  echo "Prepared $pkgbase version $(<version)"
}

